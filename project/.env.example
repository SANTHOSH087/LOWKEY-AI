# Copy this file to .env for local development, or set these as real
# environment variables in your deployment platform (Render/Railway
# dashboard). Never commit an actual .env file.

# --- required in production ---

# Selects config.py's ProductionConfig (secure cookies, DEBUG off, and a
# startup check that refuses to run with a missing/default SECRET_KEY).
# Leave unset for local development.
FLASK_CONFIG=production

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# The app will refuse to start in production without a real value here.
SECRET_KEY=

# --- database ---

# Optional. Defaults to a local SQLite file (instance/lowkey.db) if unset.
# For Render/Railway, use the Postgres connection string they provide —
# `postgres://` and `postgresql://` are both accepted.
# Note: SQLite works fine for a single small deployment, but most PaaS
# free/starter tiers use an ephemeral filesystem — the SQLite file (and any
# OCR receipt uploads) can be wiped on redeploy or restart unless you attach
# a persistent disk. Postgres is recommended for anything beyond local use.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- server ---

# Render/Railway set PORT automatically — you normally don't need to set this.
# PORT=8000

# Gunicorn log verbosity: debug | info | warning | error
# LOG_LEVEL=info

# --- AI Assistant (optional) ---

# If unset, the AI Assistant uses its built-in rule-based engine (reads
# real data straight from your SQLite/Postgres tables — no external calls).
# Set this to enable OpenAI-enhanced replies on top of that same data.
# Note: only OpenAI is wired up in blueprints/assistant/llm.py today —
# there is no Gemini integration in the current codebase.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- session security ---

# Minutes of inactivity before a session is force-expired (checked against
# the UserSession table on every request, independent of the browser
# cookie's own lifetime). Default: 30.
# SESSION_TIMEOUT_MINUTES=30

# --- rate limiting ---

# Backs login/register/password-reset/2FA/AI-chat rate limits (Flask-Limiter).
# Defaults to in-memory storage, which is fine for a single Gunicorn worker.
# If you run more than one worker/instance, set this to a shared Redis URL —
# otherwise each process tracks its own separate counts and the real
# effective limit becomes (your configured limit) × (number of workers).
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# --- email (password reset + suspicious-login alerts) ---

# If MAIL_USERNAME is unset, emails are written to the app log instead of
# sent — password reset and 2FA setup still work end-to-end locally without
# any of this configured. Set these for real email delivery in production.
# See DEPLOYMENT.md for provider-specific notes (Gmail app passwords,
# SendGrid, etc.).
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=1
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=no-reply@yourdomain.com

# --- malware scanning (optional) ---

# If unset, uploaded receipt images skip the ClamAV scan step (extension +
# size + real MIME-sniffing checks still apply either way) — OCR isn't
# broken for anyone who hasn't set up a ClamAV daemon. See DEPLOYMENT.md
# for how to run one alongside the app.
# CLAMD_HOST=localhost
# CLAMD_PORT=3310
